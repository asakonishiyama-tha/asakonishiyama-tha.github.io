{
  "name": "hooked_presentation",
  "version": "1.0.0",
  "description": "- 初版作成日: 2026-08-11 - 対象登壇者: 西山朝子社長を中心とするTHA登壇者 - ステータス: 体験設計確定、実装準備中",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "predev": "node scripts/prepare-public-assets.mjs",
    "dev": "next dev",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "prevalidate:assets": "node scripts/prepare-public-assets.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "prebuild": "node scripts/prepare-public-assets.mjs",
    "build": "npm run validate:content && npm run validate:assets && next build",
    "preview:static": "node scripts/serve-static-export.mjs --directory out --hostname 127.0.0.1 --port 3000",
    "release:prepare": "node scripts/build-public-source.mjs",
    "release:scan": "node scripts/scan-release-safety.mjs",
    "start": "npm run preview:static",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:static": "node scripts/verify-static-export.mjs out"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "motion": "^13.1.0",
    "next": "^15.5.23",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "ffprobe-static": "^3.1.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
